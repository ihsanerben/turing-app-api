DB_URL=jdbc:postgresql://postgres:5432/turing_app
DB_USERNAME=turing_user
DB_PASSWORD=change-me-for-non-local-environments
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P14D
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW=PT15M
PROFILE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
EMAIL_VERIFICATION_EXPIRATION=PT24H
PASSWORD_RESET_EXPIRATION=PT1H
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
FRONTEND_BASE_URL=http://localhost:5173

MINIO_ROOT_USER=turing_minio
MINIO_ROOT_PASSWORD=change-me-for-non-local-environments
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=turing_minio
S3_SECRET_KEY=change-me-for-non-local-environments
S3_BUCKET=turing-documents

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@turing.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
